# ============================================================
#  Amiri — намунаи танзимот.  Нусха бигиред:  cp .env.example .env
#  Дар .env қиматҳои воқеиро гузоред. .env ба git НАМЕРАВАД.
# ============================================================

# --- Telegram ---
# Токен аз @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# polling — барои кор дар компютер (домен лозим нест)
# webhook — барои сервери оммавӣ
BOT_MODE=polling
# Домени оммавии backend (танҳо барои webhook ва линки панел)
PUBLIC_URL=http://localhost:8000
# Сатри тасодуфӣ — қисми роҳи webhook мешавад
WEBHOOK_SECRET=change-me-to-random-string

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Пойгоҳи маълумот ---
DATABASE_URL=postgresql+asyncpg://postgres:PAROL@localhost:5432/amiri

# --- Амният ---
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-random-64-chars
JWT_TTL_DAYS=7
MAGIC_TOKEN_TTL_MINUTES=5

# --- Панел ---
PANEL_URL=http://localhost:5173

# --- Пешфарзҳо ---
DEFAULT_LANG=ru
DEFAULT_CURRENCY=TJS
DEFAULT_TZ=Asia/Dushanbe

# --- Курси валюта ---
FX_API_URL=https://open.er-api.com/v6/latest


# ============================================================
#  Танҳо барои Docker (docker compose). Ҳангоми оғози маҳаллӣ
#  бе Docker ин сатрҳо истифода намешаванд.
# ============================================================
POSTGRES_USER=amiri
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
POSTGRES_DB=amiri

# Портҳои ғайримаъмул — то бо сервисҳои мавҷуди сервер бархӯрд накунанд
API_PORT=8347
DB_PORT=5459
