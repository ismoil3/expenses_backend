# ============================================================
#  Amiri — .env-и деплой.  Дар папкаи `expenses/` мехобад.
#  Ба git НАМЕРАВАД. Скрипти оғоз сирҳои тасодуфиро худаш месозад.
# ============================================================

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=amiri_expenses_bot

# polling — бе домен низ кор мекунад (сервер худаш ба Telegram муроҷиат мекунад)
# webhook — танҳо агар домени HTTPS дошта бошед
BOT_MODE=polling
PUBLIC_URL=http://SERVER_IP:8347
WEBHOOK_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Амният ---
JWT_SECRET=
JWT_TTL_DAYS=7
MAGIC_TOKEN_TTL_MINUTES=5

# --- Панел ---
# Ҳамон суроға, ки корбар дар браузер мекушояд. Аз ин линки вуруд сохта мешавад.
PANEL_URL=http://SERVER_IP:8348

# --- Пешфарзҳо ---
DEFAULT_LANG=ru
DEFAULT_CURRENCY=TJS
DEFAULT_TZ=Asia/Dushanbe
FX_API_URL=https://open.er-api.com/v6/latest

# --- Пойгоҳи маълумот (танҳо дар дохили Docker) ---
POSTGRES_USER=amiri
POSTGRES_PASSWORD=
POSTGRES_DB=amiri

# --- Портҳо (ғайримаъмул, то бо сервисҳои мавҷуди сервер бархӯрд накунанд) ---
API_PORT=8347
WEB_PORT=8348
DB_PORT=5459
